{
  "manifest_version": 3,
  "name": "Distill Down: tabs to clean Markdown & PDF",
  "version": "0.1.0",
  "description": "Turn highlighted tabs into clean Markdown or PDF, saved or copied for your AI tools. Runs in your browser; nothing is sent anywhere.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "downloads", "notifications", "storage", "offscreen", "clipboardWrite"],
  "optional_permissions": ["debugger"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Distill highlighted tabs"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
